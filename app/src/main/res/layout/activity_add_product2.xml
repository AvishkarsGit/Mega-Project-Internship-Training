<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".activities.Add_product_activity">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:elevation="50dp"
        android:id="@+id/toolbarRl"
        android:background="@color/white"
        android:layout_marginBottom="30dp"
        >

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Add New Product "
            android:textColor="#444456"
            android:textSize="20dp"
            android:textStyle="bold"
            android:layout_centerVertical="true"
            android:layout_marginLeft="50dp"/>

        <ImageButton
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/btnBackProduct"
            android:layout_alignParentLeft="true"
            android:src="@drawable/back"
            android:layout_centerVertical="true"
            android:layout_marginLeft="10dp"
            android:background="@android:color/transparent"
            />

        </RelativeLayout>

    <ImageView
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:layout_below="@id/toolbarRl"
        android:layout_centerHorizontal="true"
        android:id="@+id/addProduct"
        android:layout_marginBottom="20dp"/>

    <Button
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_below="@id/addProduct"
        android:layout_centerHorizontal="true"
        android:text="Set Image"
        android:id="@+id/setBtn"
        android:layout_marginBottom="10dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/setBtn"
        android:layout_centerHorizontal="true"
        android:text="Title"
        android:id="@+id/title"
        android:textSize="20dp"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:layout_marginBottom="10dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/title"
        android:layout_centerHorizontal="true"
        android:text="Description"
        android:id="@+id/discp_text"
        android:textSize="15dp"
        android:textColor="@color/black"
        android:layout_marginBottom="30dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/discp_text"
        android:layout_centerHorizontal="true"
        android:text="Price ?"
        android:id="@+id/price"
        android:textSize="25dp"
        android:textStyle="bold"
        android:textColor="@color/black"/>

    <Switch
        android:id="@+id/available_switch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/price"
        android:layout_marginTop="20dp"
        android:text="Discount"
        android:textStyle="bold"
        android:textSize="18sp"
        android:textColor="@color/black"
        android:switchPadding="30dp"
        android:layout_marginStart="170dp"
        tools:ignore="UseSwitchCompatOrMaterialXml"
        android:layout_marginBottom="20dp" />


    <CheckBox
        android:id="@+id/checkbox_terms"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/available_switch"
        android:layout_alignParentEnd="true"
        android:layout_marginEnd="15dp"
        android:text="Tax Included (18% Gst)"
        android:textColor="@color/black" />


    <Button
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="10dp"
        android:text="Add Product"
        android:layout_margin="10dp"
        android:backgroundTint="#444456"
        android:textColor="@color/white"/>






</RelativeLayout>